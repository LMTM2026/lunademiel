rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo la cuenta del viaje (usuario LMTM) puede ver y editar los datos.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'lmtm@lmtm.app';
    }
  }
}
